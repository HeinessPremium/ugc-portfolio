# Password for the /admin page and upload/delete API. Set this in Vercel's
# Project Settings → Environment Variables (not needed locally unless you
# run `next dev`).
ADMIN_PASSWORD=choose-a-strong-password

# BLOB_READ_WRITE_TOKEN is added automatically to your Vercel project once
# you connect a Blob store — you don't set it by hand on Vercel.
# For local dev/seeding, run `vercel env pull .env.local` to fetch it.
